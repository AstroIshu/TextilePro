<UserControl x:Class="TextilePro.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <converters:RiskToColorConverter x:Key="RiskToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToEditAddConverter x:Key="BoolToEditAddConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock Text="📦 CC Inventory Management"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1a1a1a"
                           VerticalAlignment="Center"/>
                <TextBlock Text="(Upload Excel or add manual entries)"
                           FontSize="12"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Actions -->
                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="White"
                        Padding="12"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋 Actions"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#333333"
                                   Margin="0,0,0,12"/>

                        <!-- Download Template -->
                        <Button Content="⬇️ Download Template"
                                Command="{Binding DownloadTemplateCommand}"
                                Background="#E8F0FE"
                                Foreground="#0078D4"
                                BorderThickness="1"
                                BorderBrush="#0078D4"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"/>

                        <!-- Upload Excel -->
                        <Button Content="📤 Upload Excel"
                                Command="{Binding UploadExcelCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"/>

                        <!-- Manual Entry -->
                        <Button Content="➕ Manual Entry"
                                Command="{Binding OpenManualEntryModalCommand}"
                                Background="#28A745"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Stretch"/>

                        <Border Background="#F0F7FF"
                                Padding="8"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"
                                       FontSize="11"
                                       Foreground="#333"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="🔍 Filters"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#333333"
                                   Margin="0,0,0,8"/>

                        <!-- Filters
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding FilterSupplier}"
                              SelectedValuePath="Name"
                              Margin="0,0,0,8"
                              Padding="8"
                              FontSize="12"
                              Background="White"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"
