                            Cursor="Hand"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border> -->
                        <!-- Filter by Chemical -->
                        <TextBlock Text="Chemical"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox Text="{Binding FilterChemical, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,8,8" FontSize="12" AutomationProperties.Name="Search inventory chemicals"/>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Filter by Month -->
                        <TextBlock Text="Month"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding MonthFilterOptions}"
                                  SelectedItem="{Binding FilterMonth}"
                                  Margin="0,0,0,10"
                                  Padding="8"
                                  FontSize="12"
                                  Background="White"
                                  BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="1">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <ToggleButton MinHeight="40" x:Name="ToggleButton"
                                                                  Grid.ColumnSpan="2"
                                                                  Focusable="False"
                                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="White"
                                                                  BorderBrush="{DynamicResource Brush.Border}"
                                                                  BorderThickness="1">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="30"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ContentPresenter Grid.Column="0"
                                                                                                      Content="{TemplateBinding Content}"
                                                                                                      Margin="8,6"
                                                                                                      VerticalAlignment="Center"/>
                                                                                    <Path Grid.Column="1"
                                                                                          Data="M0,0 L5,5 L10,0"
                                                                                          Stroke="#666"
                                                                                          StrokeThickness="2"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Popup x:Name="Popup"
                                                           IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           PlacementTarget="{Binding ElementName=ToggleButton}"
                                                           StaysOpen="False">
                                                        <Border Background="White"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                Padding="4"
                                                                MaxHeight="200">
                                                            <ScrollViewer>
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <Button Style="{StaticResource Button.Secondary}" Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Height="32"/>
                    </StackPanel>
                    <!-- </ScrollViewer> -->
                </Border>

                <!-- Right Panel: Inventory Grid -->
                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Background="White"
                        Padding="16"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="Inventory Records"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding InventoryRecords.Count}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{DynamicResource Brush.Secondary}"
                                       Margin="8,0,0,0"/>
                            <TextBlock Text="records"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Margin="4,0,0,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding InventoryRecords}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  FontSize="13"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier"
                                                    Binding="{Binding SupplierName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Chemical"
                                                    Binding="{Binding ChemicalName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="CAS"
                                                    Binding="{Binding CAS}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Volume"
                                                    Binding="{Binding Volume}"
                                                    Width="80"/>
                                <DataGridTemplateColumn Header="Type"
                                                        Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Type, Converter={StaticResource RiskToColorConverter}}"
                                                    Padding="6,2"
                                                    Margin="4,2">
                                                <TextBlock Text="{Binding Type}"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Month"
                                                    Binding="{Binding PurchaseMonth}"
                                                    Width="100"/>
                                <DataGridTemplateColumn Header="Actions" Width="148">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Button.Compact}" Content="Edit"
                                                        Command="{Binding DataContext.EditInventoryRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        ToolTip="Edit"
                                                        Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource Button.Compact}" Content="Delete"
                                                        Command="{Binding DataContext.DeleteInventoryRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        ToolTip="Delete"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Manual Entry Modal -->
            <Grid x:Name="ModalOverlay"
                  Background="#80000000"
                  Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Panel.ZIndex="1000">
                <Border Background="White"
                        Padding="24"
                        Width="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToEditAddConverter}, FallbackValue='Manual Inventory Entry'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Supplier *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,12"
                                  Padding="8"
                                  FontSize="13"
                                  Background="White"
                                  BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="1"/>

                        <TextBlock Text="Chemical *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Chemicals}"
                                  SelectedItem="{Binding SelectedChemical}"
                                  DisplayMemberPath="ChemicalName"
                                  Margin="0,0,0,12"
                                  Padding="8"
                                  FontSize="13"
                                  Background="White"
                                  BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="1"/>

                        <TextBlock Text="Volume (kg/L) *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ManualVolume, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 FontSize="13"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Purchase Month *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ManualMonth, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 FontSize="13"
                                 Margin="0,0,0,12"/>
                        <TextBlock Text="Format: MMM-YYYY (e.g., Jan-2025)"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,-8,0,12"/>

                        <TextBlock Text="{Binding ModalStatus}"
                                   FontSize="11"
                                   Foreground="#E81123"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Secondary}" Content="Cancel"
                                    Command="{Binding CloseModalCommand}"
                                    Cursor="Hand"
                                    Margin="0,0,12,0"/>
                            <Button Style="{StaticResource Button.Primary}" Content="Save"
                                    Command="{Binding SaveManualEntryCommand}"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
