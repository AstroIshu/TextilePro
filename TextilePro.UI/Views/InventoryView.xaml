<UserControl x:Class="TextilePro.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:RiskToColorConverter x:Key="RiskToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToEditAddConverter x:Key="BoolToEditAddConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <WrapPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock TextWrapping="Wrap" Text="CC Inventory Management"
                           Style="{StaticResource Text.PageTitle}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="(Upload Excel or add manual entries)"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </WrapPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Actions -->
                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="White"
                        Padding="12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Actions"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,12"/>

                        <!-- Download Template -->
                        <Button Style="{StaticResource Button.Secondary}" Content="Download Template"
                                Command="{Binding DownloadTemplateCommand}"
                                BorderBrush="{DynamicResource Brush.Secondary}"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"/>

                        <!-- Upload Excel -->
                        <Button Style="{StaticResource Button.Primary}" Content="Upload Excel"
                                Command="{Binding UploadExcelCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"/>

                        <!-- Manual Entry -->
                        <Button Style="{StaticResource Button.Secondary}" Content="Manual Entry"
                                Command="{Binding OpenManualEntryModalCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Stretch"/>

                        <Border Background="#F0F7FF"
                                Padding="8"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Filters"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,8"/>

                        <!-- Filters
