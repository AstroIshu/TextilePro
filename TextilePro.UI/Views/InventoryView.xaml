                                                Value="#FAFAFA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="Search chemical..."
                            FontSize="11"
                            Foreground="#AAAAAA"
                            Margin="8,-28,0,0"
                            IsHitTestVisible="False"/>

                    <ComboBox ItemsSource="{Binding MonthFilterOptions}"
                              SelectedValue="{Binding FilterMonth}"
