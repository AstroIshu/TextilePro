                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="🔍 Search chemical..."
                            FontSize="10"
                            Foreground="#AAAAAA"
                            Margin="8,-28,0,0"
                            IsHitTestVisible="False"/>

                    <ComboBox ItemsSource="{Binding MonthFilterOptions}"
                              SelectedValue="{Binding FilterMonth}"
                              Margin="0,0,0,8"
                              Padding="8"
                              FontSize="12"
                              Background="White"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"
