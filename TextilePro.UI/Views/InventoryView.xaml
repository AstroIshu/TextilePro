                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <Button Content="❌ Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Background="#E0E0E0"
                            Foreground="#333"
                            BorderThickness="0"
