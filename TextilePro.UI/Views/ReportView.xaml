<UserControl x:Class="TextilePro.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="📄 Reports" FontSize="22" FontWeight="Bold" Foreground="#1a1a1a" VerticalAlignment="Center"/>
            <TextBlock Text="(Export data in Excel or PDF format)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Border Grid.Row="1" CornerRadius="8" Background="White" Padding="24" BorderBrush="#D0D0D0" BorderThickness="1" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="📋 Select Tabs to Export" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,12"/>

                    <!-- Tab selection checkboxes -->
                    <ItemsControl ItemsSource="{Binding AvailableTabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,6">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" FontSize="13">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F0F7FF" CornerRadius="4" Padding="8" Margin="0,12,0,12">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#333" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Export Buttons -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📊 Generate Excel Report" Command="{Binding GenerateExcelReportCommand}" 
                            Background="#1B5E20" Foreground="White" BorderThickness="0"
                            Padding="16,10" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="1" Content="📄 Generate PDF Report" Command="{Binding GeneratePdfReportCommand}" 
                            Background="#B71C1C" Foreground="White" BorderThickness="0"
                            Padding="16,10" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Loading indicator -->
                        <Border Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Margin="0,12,0,0" Background="#FFF9C4" CornerRadius="4" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Generating report... Please wait." FontSize="13" Foreground="#333"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>