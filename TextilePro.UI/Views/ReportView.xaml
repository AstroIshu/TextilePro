<UserControl x:Class="TextilePro.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Reports" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center"/>
            <TextBlock Text="(Export data in Excel or PDF format)" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Border Grid.Row="1" CornerRadius="8" Background="White" Padding="24" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Select report sections" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose the sections to include, then select an output format." Style="{StaticResource Text.Metadata}" Margin="0,0,0,16"/>

                    <!-- Tab selection checkboxes -->
                    <ItemsControl ItemsSource="{Binding AvailableTabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Canvas}" CornerRadius="6" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" FontSize="15">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F0F7FF" CornerRadius="6" Padding="8" Margin="0,12,0,12"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyTextToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Export Buttons -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource Button.Secondary}" Grid.Column="0" Content="Generate Excel report" Command="{Binding GenerateExcelReportCommand}" Margin="0,0,8,0" Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                        </Button>

                        <Button Style="{StaticResource Button.Primary}" Grid.Column="1" Content="Generate PDF report" Command="{Binding GeneratePdfReportCommand}" Margin="8,0,0,0" Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}">
                        </Button>
                    </Grid>

                    <!-- Loading indicator -->
                        <Border Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Margin="0,12,0,0" Background="#FFF9C4" CornerRadius="6" Padding="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Generating report... Please wait." FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
