<UserControl x:Class="TextilePro.UI.Views.ClassificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Supplier Classification Matrix"
                    Style="{StaticResource Text.PageTitle}"
                    VerticalAlignment="Center"/>
            <TextBlock Text="(Supplier performance &amp; risk assessment)"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Border Grid.Row="1"
               
                Background="White"
                Padding="16"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0"
                        Margin="0,0,0,16"
                        Padding="0,0,0,12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Brush.Border}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Filters" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Classification" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ClassFilterOptions}" SelectedItem="{Binding SelectedClassFilter}" AutomationProperties.Name="Filter by classification"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Supplier" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SupplierNames}" SelectedItem="{Binding SelectedSupplier}" AutomationProperties.Name="Select supplier"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="Product search" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,8,8" AutomationProperties.Name="Search products"/>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>

                        <Button Style="{StaticResource Button.Secondary}" Grid.Row="1" Grid.Column="3" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Cursor="Hand" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ClassificationItems}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          Background="White"
                        BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="42"
                          FontSize="13"
                          IsReadOnly="True"
                          AlternatingRowBackground="#F9F9F9">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding"
                                    Value="8,4"/>
                            <Setter Property="VerticalAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Supplier Name"
                                Binding="{Binding SupplierName}"
                                Width="2*"/>
                        <DataGridTextColumn Header="Product"
                                Binding="{Binding ProductName}"
                                Width="2*"/>
                        <DataGridTextColumn Header="Score"
                                Binding="{Binding Score}"
                            Width="80"/>

                        <DataGridTemplateColumn Header="Class"
                            Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2"
                                            HorizontalAlignment="Center"
                                            MinWidth="50">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#9E9E9E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Class}" Value="A">
                                                        <Setter Property="Background" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Class}" Value="B">
                                                        <Setter Property="Background" Value="#ED6C02" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Class}" Value="C">
                                                        <Setter Property="Background" Value="#D32F2F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Class}" Value="Pending">
                                                        <Setter Property="Background" Value="#9E9E9E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Class}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Action required"
                                Binding="{Binding Action}"
                                Width="2.4*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status Footer -->
                <Border Grid.Row="1"
                        Background="#F0F7FF"
                        
                        Padding="8"
                        VerticalAlignment="Bottom"
                        Height="30"
                        Margin="0,0,0,0">
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Loading data...'}"
                               FontSize="11"
                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
