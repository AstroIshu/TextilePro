<Window x:Class="TextilePro.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="TextilePro — Sign in" Height="680" Width="1080" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="White">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,36">
                    <Border Width="44" Height="44" CornerRadius="9" Background="{DynamicResource Brush.Primary}"><Grid>
                        <Rectangle Width="23" Height="6" RadiusX="2" Fill="White" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="23" Height="6" RadiusX="2" Fill="{DynamicResource Brush.ThreadBeige}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle>
                    </Grid></Border>
                    <StackPanel Margin="12,0,0,0"><TextBlock Text="TextilePro" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}"/><TextBlock Text="Chemical Compliance" Style="{StaticResource Text.Metadata}"/></StackPanel>
                </StackPanel>

                <TextBlock Text="Welcome back" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Sign in to manage supplier chemical compliance." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,30"/>

                <TextBlock Text="Username" Style="{StaticResource Text.Label}" Margin="0,0,0,7"/>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" AutomationProperties.Name="Username"/>
                <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,0,0,7"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" AutomationProperties.Name="Password"/>

                <Border Background="#FBE9E9" BorderBrush="#F2C4C4" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyTextToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.ClassC}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Button Content="Sign in" Command="{Binding LoginCommand}" Style="{StaticResource Button.Primary}" Height="44" HorizontalContentAlignment="Center"
                        IsDefault="True" IsEnabled="{Binding IsLoading, Converter={StaticResource BoolNegationConverter}}"/>
                <Button Content="Exit application" Command="{Binding ExitApplicationCommand}" Style="{StaticResource Button.Tertiary}" Margin="0,10,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Version 1.0  •  Local compliance data remains on this device" Style="{StaticResource Text.Metadata}" Margin="28,0,28,22" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Column="1" Background="{DynamicResource Brush.Primary}" ClipToBounds="True">
            <Canvas Opacity="0.12" IsHitTestVisible="False">
                <Rectangle Width="900" Height="18" Fill="White" Canvas.Left="-180" Canvas.Top="90" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="900" Height="18" Fill="{DynamicResource Brush.ThreadBeige}" Canvas.Left="-170" Canvas.Top="250" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="900" Height="18" Fill="White" Canvas.Left="-200" Canvas.Top="430" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="900" Height="18" Fill="{DynamicResource Brush.ThreadBeige}" Canvas.Left="-190" Canvas.Top="590" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle>
            </Canvas>
            <StackPanel Margin="58" VerticalAlignment="Center">
                <TextBlock Text="Chemical Compliance." Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Safer Textiles." Foreground="{DynamicResource Brush.ThreadBeige}" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,22"/>
                <Rectangle Height="2" Width="54" Fill="{DynamicResource Brush.ThreadBeige}" HorizontalAlignment="Left" Margin="0,0,0,22"/>
                <TextBlock Text="Clear supplier traceability, consistent classification and responsible chemistry, in one dependable workspace." Foreground="#E8EEF4" FontSize="14" LineHeight="22" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock Text="RESPONSIBLE CHEMISTRY" Foreground="#99FFFFFF" FontSize="10" FontWeight="SemiBold" Margin="58,0,0,34" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
