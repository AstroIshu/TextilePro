<UserControl x:Class="TextilePro.UI.Views.ChemicalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:RiskToColorConverter x:Key="RiskToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Commodity Chemical Assignment"
                    Style="{StaticResource Text.PageTitle}"
                    VerticalAlignment="Center"/>
            <TextBlock Text="(Assign ZDHC-approved chemicals to suppliers)"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Supplier List -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Background="White"
                    Padding="12"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Select Supplier"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Suppliers}"
                             SelectedItem="{Binding SelectedSupplier}"
                             DisplayMemberPath="Name"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,0,0,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5F1FB"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Secondary}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Grid.Row="2"
                            Background="#F0F7FF"
                            Padding="8"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Select a supplier to view their chemicals.'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Button Style="{StaticResource Button.Secondary}" Grid.Row="3"
                            Content="Refresh"
                            Command="{Binding LoadAllChemicalsCommand}"
                            Cursor="Hand">
                    </Button>
                </Grid>
            </Border>

            <!-- Right Panel: Chemical List -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                   
                    Background="White"
                    Padding="16"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Sort -->
                    <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                        <TextBlock Text="All ZDHC Chemicals (88)"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,8,8" FontSize="13" AutomationProperties.Name="Search chemicals"/>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"/>
                            </Grid>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOption}"
                                      Width="180"
                                      Padding="6"
                                      FontSize="12"
                                      Background="White"
                                      BorderBrush="{DynamicResource Brush.Border}"
                                      BorderThickness="1"
                                     />
                        </Grid>
                    </StackPanel>

                    <!-- Chemical List with Checkboxes -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                           
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                                <Button Style="{StaticResource Button.Secondary}" Content="Select All"
                                        Command="{Binding SelectAllChemicalsCommand}"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Button.Secondary}" Content="Deselect All"
                                        Command="{Binding DeselectAllChemicalsCommand}"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Button.Primary}" Content="Assign Selected"
                                        Command="{Binding AssignSelectedChemicalsCommand}"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"/>
                            </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                      VerticalAlignment="Stretch"
                                      VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredChemicals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,6">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center"
                                                          FontSize="13">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Serial}"
                                                                Width="40"
                                                                Foreground="{DynamicResource Brush.TextMuted}"/>
                                                        <TextBlock Text="{Binding ChemicalName}"
                                                                Width="200"
                                                                FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CAS}"
                                                                Width="130"
                                                                Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                        <Border Background="{Binding RiskCategory, Converter={StaticResource RiskToColorConverter}}"
                                                              
                                                                Padding="6,2"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding RiskCategory}"
                                                                    FontSize="11"
                                                                    Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Assigned Chemicals -->
                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Padding="8"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                                <TextBlock Text="Assigned to "
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSupplier.Name, FallbackValue='[No Supplier Selected]'}"
                                           FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.Secondary}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text=" ("
                                        FontWeight="Normal"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AssignedChemicals.Count}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.Secondary}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text=" chemicals)"
                                        FontWeight="Normal"
                                        FontSize="12"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        VerticalAlignment="Center"/>
                                <Button Style="{StaticResource Button.Destructive}" Content="Remove Selected"
                                        Command="{Binding DeleteSelectedChemicalsCommand}"
                                        Cursor="Hand"
                                        Margin="20,0,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AssignedChemicals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,4">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                        VerticalAlignment="Center"
                                                        FontSize="12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Serial}"
                                                                Width="35"
                                                                Foreground="{DynamicResource Brush.TextMuted}"/>
                                                        <TextBlock Text="{Binding ChemicalName}"
                                                                Width="180"
                                                                FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CAS}"
                                                                Width="130"
                                                                Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                        <Border Background="{Binding RiskCategory, Converter={StaticResource RiskToColorConverter}}"
                                                               
                                                                Padding="6,2"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding RiskCategory}"
                                                                    FontSize="11"
                                                                    Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Status -->
                    <Border Grid.Row="3"
                            Background="#F0F7FF"
                            Padding="8">
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Select a supplier to begin.'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
