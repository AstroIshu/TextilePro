<UserControl x:Class="TextilePro.UI.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:IdToStatusConverter x:Key="IdToStatusConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Supplier Management"
                    Style="{StaticResource Text.PageTitle}"
                    VerticalAlignment="Center"/>
            <Button Style="{StaticResource Button.Secondary}" Content="New Supplier"
                    Command="{Binding NewSupplierCommand}"
                    Margin="20,0,0,0"
                    Cursor="Hand">
            </Button>
            <TextBlock Text="(Select a supplier from the left to edit)"
                       FontSize="12"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Supplier List -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Background="White"
                    Padding="12"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                        <TextBlock Text="Supplier List"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Margin="0,0,0,8"/>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    
                                     FontSize="13"
                                    Background="#FAFAFA"/>
                            <TextBlock Text="Search suppliers..."
                                    FontSize="13"
                                    Foreground="#AAAAAA"
                                       Padding="8,0,0,0"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center"
                                       Visibility="{Binding ElementName=SearchBox, Path=Text, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>

                        <ListBox Grid.Row="1"
                            ItemsSource="{Binding Suppliers}"
                             SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                             Background="Transparent"
                            BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"
                                        Value="10,8"/>
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>
                                <Setter Property="BorderBrush"
                                        Value="#EEEEEE"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                            Value="True">
                                        <Setter Property="Background"
                                                Value="#E5F1FB"/>
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource Brush.Secondary}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter Property="Background"
                                                Value="#F0F7FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!-- ListBox ItemTemplate -->
<ListBox.ItemTemplate>
    <DataTemplate>
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{Binding Country, StringFormat='{}{0}'}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBlock Text="{Binding Contacts.Count, StringFormat='{}{0} contact(s)'}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
    </DataTemplate>
</ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                            Text="No suppliers yet. Click 'New Supplier' to add one."
                               FontSize="12"
                            Foreground="#999999"
                               HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                               Visibility="{Binding Suppliers.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Right: Edit Form -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    
                    Background="White"
                    Padding="20"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <StackPanel Grid.Row="0"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedSupplier.Name, FallbackValue='New supplier'}"
                                       FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedSupplier.Id, Converter={StaticResource IdToStatusConverter}, FallbackValue='New'}"
                                       FontSize="11"
                                    Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Supplier Information -->
                        <Border Grid.Row="1"
                                Margin="0,0,0,16"
                                Padding="0,0,0,12"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <StackPanel>
                                <TextBlock Text="Supplier Information"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                            Text="Name *"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBox Grid.Column="1"
                                            Text="{Binding SelectedSupplier.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            
                                             FontSize="13"
                                            Background="White"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                            Text="Country"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBox Grid.Column="1"
                                            Text="{Binding SelectedSupplier.Country, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                           
                                             FontSize="13"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                            Text="Address"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Top"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Margin="0,4,0,0"/>
                                    <TextBox Grid.Column="1"
                                            Text="{Binding SelectedSupplier.Address, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            
                                             AcceptsReturn="True"
                                            MinLines="1"
                                            MaxLines="4"
                                            MinHeight="44"
                                            MaxHeight="112"
                                            VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                             FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Contacts Section -->
                        <Border Grid.Row="2"
                                Margin="0,0,0,12"
                                Padding="0,8,0,0"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Contacts"
                                            FontWeight="SemiBold"
                                            FontSize="14"
                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Text="Add one or more contacts for this supplier"
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                                <Button Style="{StaticResource Button.Primary}" Grid.Column="1"
                                        Content="Add Contact"
                                        Command="{Binding AddContactCommand}"
                                        BorderBrush="{DynamicResource Brush.Secondary}"
                                        Cursor="Hand"
                                        Margin="0,0,0,8">
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Contact cards -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Contacts}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16" Margin="0,0,0,12" CornerRadius="8" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <Button DockPanel.Dock="Right" Content="Remove contact" Style="{StaticResource Button.Compact}" HorizontalAlignment="Right" Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="Contact details" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,12"><TextBlock Text="Contact name" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/><TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contact name"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Email address" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email address"/></StackPanel>
                                            </Grid>
                                            <TextBlock Text="Phone number" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0,0,8,0" PreviewTextInput="CountryCode_PreviewTextInput" DataObject.Pasting="CountryCode_Pasting" AutomationProperties.Name="Country calling code" ToolTip="Country calling code, for example +91"/>
                                                <TextBox Grid.Column="1" Text="{Binding LocalPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" PreviewTextInput="PhoneNumber_PreviewTextInput" DataObject.Pasting="PhoneNumber_Pasting" AutomationProperties.Name="10 digit phone number"/>
                                            </Grid>
                                            <TextBlock Text="Website" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Website"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Save Supplier"
                                    Command="{Binding SaveSupplierCommand}"
                                    Margin="0,0,12,0"
                                    Cursor="Hand">
                            </Button>
                            <Button Style="{StaticResource Button.Compact}" Content="Delete"
                                    Command="{Binding DeleteSupplierCommand}"
                                    CommandParameter="{Binding SelectedSupplier}"
                                    Cursor="Hand">
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
