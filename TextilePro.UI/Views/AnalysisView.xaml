<UserControl x:Class="TextilePro.UI.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TextilePro.UI.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BoolNegationConverter x:Key="BoolNegationConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Purchase Analysis"
                       Style="{StaticResource Text.PageTitle}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="(Volume trends by class and supplier type)"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border CornerRadius="8"
                        Background="#FFF8E1"
                        Padding="12"
                        Margin="0,0,0,12"
                        BorderBrush="#E6C96A"
                        BorderThickness="1"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyTextToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#6B4E00"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <UniformGrid Grid.Column="0" Columns="3" Margin="0,0,16,0">
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Purchase year" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="130" FontSize="15" AutomationProperties.Name="Purchase year"/></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="From month" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding StartMonth}" Width="150" FontSize="15" AutomationProperties.Name="From month"/></StackPanel>
                            <StackPanel><TextBlock Text="To month" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding EndMonth}" Width="150" FontSize="15" AutomationProperties.Name="To month"/></StackPanel>
                        </UniformGrid>
                        <Button Style="{StaticResource Button.Secondary}" Grid.Column="2"
                                Content="Reset"
                                Command="{Binding ResetFiltersCommand}"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Total Volume" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding TotalVolume}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassA}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Margin="8,0,8,0"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Class A Share" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding ClassAPercentage}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Secondary}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Margin="8,0,8,0"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Virgin Volume" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VirginVolume, StringFormat={}{0:N1}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassB}"/><TextBlock Text="{Binding VirginPercentage, StringFormat={}  ({0})}" FontSize="14" Margin="6,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/></StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3"
                                Margin="8,0,0,0"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Non-Virgin Volume" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding NonVirginVolume, StringFormat={}{0:N1}}" FontSize="18" FontWeight="SemiBold" Foreground="#6A1B9A"/><TextBlock Text="{Binding NonVirginPercentage, StringFormat={}  ({0})}" FontSize="14" Margin="6,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0">
                            <lvc:CartesianChart
                                Series="{Binding BarSeries}"
                                XAxes="{Binding BarXAxes}"
                                YAxes="{Binding BarYAxes}"
                                LegendPosition="Top"
                                Height="300"
                                Margin="10" />
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0">
                            <lvc:PieChart Series="{Binding PieSeries}"
                                          LegendPosition="Bottom"
                                          Height="430"
                                          HorizontalAlignment="Stretch"
                                          Margin="10"/>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Month-wise Breakdown"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding MonthData}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="120"/>
                                <DataGridTextColumn Header="Class A" Binding="{Binding ClassA}" Width="*"/>
                                <DataGridTextColumn Header="Class B" Binding="{Binding ClassB}" Width="*"/>
                                <DataGridTextColumn Header="Class C" Binding="{Binding ClassC}" Width="*"/>
                                <DataGridTextColumn Header="Virgin" Binding="{Binding Virgin}" Width="*"/>
                                <DataGridTextColumn Header="Non-Virgin" Binding="{Binding NonVirgin}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
