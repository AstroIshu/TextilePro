<UserControl x:Class="TextilePro.UI.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TextilePro.UI.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F5F5">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BoolNegationConverter x:Key="BoolNegationConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <TextBlock Text="📈 Purchase Analysis"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1a1a1a"
                       VerticalAlignment="Center"/>
            <TextBlock Text="(Volume trends by class and supplier type)"
                       FontSize="12"
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border CornerRadius="8"
                        Background="#FFF8E1"
                        Padding="12"
                        Margin="0,0,0,12"
                        BorderBrush="#E6C96A"
                        BorderThickness="1">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#6B4E00"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="Year:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Years}"
                                      SelectedItem="{Binding SelectedYear}"
                                      Width="100"
                                      Margin="0,0,16,0"
                                      Padding="4"
                                      FontSize="12"/>

                            <TextBlock Text="From:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding MonthOptions}"
                                      SelectedItem="{Binding StartMonth}"
                                      Width="120"
                                      Margin="0,0,16,0"
                                      Padding="4"
                                      FontSize="12"/>

                            <TextBlock Text="To:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding MonthOptions}"
                                      SelectedItem="{Binding EndMonth}"
                                      Width="120"
                                      Margin="0,0,16,0"
                                      Padding="4"
                                      FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Reset"
                                Command="{Binding ResetFiltersCommand}"
                                Background="#E0E0E0"
                                Foreground="#333"
                                BorderThickness="0"
                                Padding="12,6"
                                FontSize="12"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="#E8F5E9"
                                CornerRadius="4"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Total Volume" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding TotalVolume}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Margin="8,0,8,0"
                                Background="#E3F2FD"
                                CornerRadius="4"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Class A Share" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding ClassAPercentage}" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Margin="8,0,8,0"
                                Background="#FFF3E0"
                                CornerRadius="4"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Virgin Volume" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding VirginVolume}" FontSize="18" FontWeight="Bold" Foreground="#E65100"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3"
                                Margin="8,0,0,0"
                                Background="#F3E5F5"
                                CornerRadius="4"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Non-Virgin Volume" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding NonVirginVolume}" FontSize="18" FontWeight="Bold" Foreground="#6A1B9A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0">
                            <lvc:CartesianChart
                                Series="{Binding BarSeries}"
                                XAxes="{Binding BarXAxes}"
                                YAxes="{Binding BarYAxes}"
                                LegendPosition="Top"
                                Height="300"
                                Margin="10" />
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0">
                            <lvc:PieChart Series="{Binding PieSeries}"
                                          LegendPosition="Right"
                                          Height="250"
                                          Width="300"
                                          Margin="10"/>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="8"
                        Background="#FFFDF7"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="#E6C96A"
                        BorderThickness="1"
                        Visibility="{Binding HasData, Converter={StaticResource BoolNegationConverter}}">
                    <TextBlock Text="No inventory records are available yet. Add inventory entries or adjust the filters to populate the charts and breakdown table."
                               Foreground="#6B4E00"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border CornerRadius="8"
                        Background="White"
                        Padding="16"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📋 Month-wise Breakdown"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#333"
                                   Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding MonthData}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="32"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="120"/>
                                <DataGridTextColumn Header="Class A" Binding="{Binding ClassA}" Width="*"/>
                                <DataGridTextColumn Header="Class B" Binding="{Binding ClassB}" Width="*"/>
                                <DataGridTextColumn Header="Class C" Binding="{Binding ClassC}" Width="*"/>
                                <DataGridTextColumn Header="Virgin" Binding="{Binding Virgin}" Width="*"/>
                                <DataGridTextColumn Header="Non-Virgin" Binding="{Binding NonVirgin}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
