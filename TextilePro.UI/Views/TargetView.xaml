<UserControl x:Class="TextilePro.UI.Views.TargetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Target Analysis 2030" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center"/>
            <TextBlock Text="(Goal: 50% of purchases from Class A suppliers)" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Current Status (Read-only) -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Current Status" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource Brush.Canvas}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Class A Volume" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentClassAVolume}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassA}"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,8,0" Background="{DynamicResource Brush.Canvas}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Total Volume" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentTotalVolume}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Secondary}"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="8,0,0,0" Background="{DynamicResource Brush.Canvas}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Current Class A Share" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentClassAShare}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassB}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Target Settings (Editable) -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Set Your Target" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Target Share -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Class A Share (%)" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding TargetClassAShare, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassA}"
                                             Background="Transparent" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Target Year -->
                            <Border Grid.Column="1" Margin="8,0,8,0" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Year" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding YearOptions}" 
                                              SelectedItem="{Binding TargetYear}"
                                              FontSize="14" FontWeight="SemiBold"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource Brush.Secondary}"/>
                                </StackPanel>
                            </Border>

                            <!-- Calculated Values -->
                            <Border Grid.Column="2" Margin="8,0,0,0" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Class A Volume" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TargetClassAVolume}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassB}"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Additional Volume Required: " FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding AdditionalVolumeRequired}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassC}"/>
                                    <TextBlock Text=" kg/L" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Secondary}" Content="Calculate" Command="{Binding CalculateTargetCommand}" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Style="{StaticResource Button.Secondary}" Content="Reset to 50%" Command="{Binding ResetTo50PercentCommand}" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress Tracking -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Progress Tracking" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                        <!-- Progress Bar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         Height="28"
                                         Margin="0,0,12,0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercentage}"
                                         Background="{DynamicResource Brush.Canvas}"
                                         Foreground="{DynamicResource Brush.Secondary}"/>

                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Width="50" TextAlignment="Right"/>
                        </Grid>

                        <!-- Status Message -->
                        <Border CornerRadius="6" Padding="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetAchieved}" Value="True">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTargetAchieved}" Value="False">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ProgressStatus}" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Plan -->
                <Border CornerRadius="8" Background="White" Padding="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Action Plan to Achieve Target" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding ActionPlanItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="6,6">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
