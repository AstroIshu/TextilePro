<UserControl x:Class="TextilePro.UI.Views.TargetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🎯 Target Analysis 2030" FontSize="22" FontWeight="Bold" Foreground="#1a1a1a" VerticalAlignment="Center"/>
            <TextBlock Text="(Goal: 50% of purchases from Class A suppliers)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Current Status (Read-only) -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="#D0D0D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📊 Current Status" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Background="#F0F0F0" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Class A Volume" FontSize="11" Foreground="#666"/>
                                    <TextBlock Text="{Binding CurrentClassAVolume}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,8,0" Background="#F0F0F0" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Total Volume" FontSize="11" Foreground="#666"/>
                                    <TextBlock Text="{Binding CurrentTotalVolume}" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="8,0,0,0" Background="#F0F0F0" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Current Class A Share" FontSize="11" Foreground="#666"/>
                                    <TextBlock Text="{Binding CurrentClassAShare}" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Target Settings (Editable) -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="#D0D0D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="✏️ Set Your Target" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Target Share -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Background="#E8F5E9" CornerRadius="4" Padding="12" BorderBrush="#4CAF50" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Class A Share (%)" FontSize="11" Foreground="#333" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding TargetClassAShare, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="16" FontWeight="Bold" Foreground="#2E7D32"
                                             Background="Transparent" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Target Year -->
                            <Border Grid.Column="1" Margin="8,0,8,0" Background="#E3F2FD" CornerRadius="4" Padding="12" BorderBrush="#2196F3" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Year" FontSize="11" Foreground="#333" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding YearOptions}" 
                                              SelectedItem="{Binding TargetYear}"
                                              FontSize="14" FontWeight="Bold"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="#1565C0"/>
                                </StackPanel>
                            </Border>

                            <!-- Calculated Values -->
                            <Border Grid.Column="2" Margin="8,0,0,0" Background="#FFF3E0" CornerRadius="4" Padding="12" BorderBrush="#FF9800" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Target Class A Volume" FontSize="11" Foreground="#333" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TargetClassAVolume}" FontSize="16" FontWeight="Bold" Foreground="#E65100"/>
                                    <TextBlock Text="kg/L" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Background="#FCE4EC" CornerRadius="4" Padding="12" BorderBrush="#E91E63" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈 Additional Volume Required: " FontSize="12" Foreground="#333"/>
                                    <TextBlock Text="{Binding AdditionalVolumeRequired}" FontSize="14" FontWeight="Bold" Foreground="#C62828"/>
                                    <TextBlock Text=" kg/L" FontSize="12" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Calculate" Command="{Binding CalculateTargetCommand}" 
                                        Background="#0078D4" Foreground="White" BorderThickness="0"
                                        Padding="12,6" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Content="↺ Reset to 50%" Command="{Binding ResetTo50PercentCommand}" 
                                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                                        Padding="12,6" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress Tracking -->
                <Border CornerRadius="8" Background="White" Padding="16" Margin="0,0,0,12" BorderBrush="#D0D0D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📈 Progress Tracking" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,12"/>

                        <!-- Progress Bar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         Height="28"
                                         Margin="0,0,12,0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercentage}"
                                         Background="#E0E0E0"
                                         Foreground="#4CAF50"/>

                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" 
                                       FontSize="14" FontWeight="Bold" Foreground="#333" Width="50" TextAlignment="Right"/>
                        </Grid>

                        <!-- Status Message -->
                        <Border CornerRadius="4" Padding="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetAchieved}" Value="True">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTargetAchieved}" Value="False">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ProgressStatus}" FontSize="13" Foreground="#333" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Plan -->
                <Border CornerRadius="8" Background="White" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋 Action Plan to Achieve Target" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding ActionPlanItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="6,6">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#333" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>