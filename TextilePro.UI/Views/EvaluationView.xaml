<UserControl x:Class="TextilePro.UI.Views.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:ScoreToClassColorConverter x:Key="ScoreToClassColorConverter"/>
        <converters:ScoreToClassTextConverter x:Key="ScoreToClassTextConverter"/>
        <converters:ScoreToIndexConverter x:Key="ScoreToIndexConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Text="Supplier Evaluation"
                    Style="{StaticResource Text.PageTitle}"
                    VerticalAlignment="Center"/>
            <TextBlock Text="(ZDHC MRSL Compliance Scoring)"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Supplier Selection & Records -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Background="White"
                    Padding="12"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                        <TextBlock Text="Select Supplier"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  Margin="0,0,0,12"
                                  Padding="8"
                                  FontSize="13"
                                  Background="White"
                                  BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="1"
                                  >
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Secondary}" Content="New evaluation"
                                Command="{Binding NewEvaluationCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,8"/>
                        <Button Style="{StaticResource Button.Secondary}" Content="Refresh"
                                Command="{Binding LoadEvaluationRecordsCommand}"
                                Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#F0F7FF"
                           
                            Padding="8"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Select a supplier to evaluate.'}"
                                   FontSize="11"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.Canvas}"
                            Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding EvaluationRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Background="White"
                                                Margin="0,0,0,10"
                                                Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding SupplierName}"
                                                            FontWeight="SemiBold"
                                                            FontSize="15"
                                                            TextWrapping="Wrap"
                                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Text="{Binding EvaluationDate, StringFormat=Evaluated on {0}}"
                                                            FontSize="12" Margin="0,4,0,0"
                                                            Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource Button.Icon}" Width="36" Height="36" MinWidth="36" Padding="7" BorderThickness="0" Background="Transparent"
                                                            Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Edit evaluation" AutomationProperties.Name="Edit evaluation"><materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/></Button>
                                                    <Button Style="{StaticResource Button.Icon}" Width="36" Height="36" MinWidth="36" Padding="7" BorderThickness="0" Background="Transparent"
                                                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{DynamicResource Brush.ClassC}" Margin="6,0,0,0"
                                                            ToolTip="Delete evaluation" AutomationProperties.Name="Delete evaluation"><materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/></Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Primary}"><Run Text="Score "/><Run Text="{Binding Score}" FontWeight="SemiBold"/></TextBlock>
                                                    </Border>
                                                    <Border Background="{Binding Class, Converter={StaticResource ScoreToClassColorConverter}}" CornerRadius="5" Padding="8,3">
                                                        <TextBlock FontSize="12" Foreground="White" FontWeight="SemiBold"><Run Text="Class "/><Run Text="{Binding Class}"/></TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Evaluation Form -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                   
                    Background="White"
                    Padding="16"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title & Dates -->
                        <StackPanel Grid.Row="0"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedSupplier.Name, FallbackValue='Select a Supplier'}"
                                       FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Created: "
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding CreatedDateDisplay, FallbackValue='New'}"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text=" | Modified: "
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding ModifiedDateDisplay, FallbackValue='New'}"
                                        FontSize="11"
                                        Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Evaluation Header -->
                        <Border Grid.Row="1"
                                Margin="0,0,0,12"
                                Padding="0,0,0,12"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2">
                                    <TextBlock Text="Evaluation details"
                                            FontWeight="SemiBold"
                                            FontSize="14"
                                            Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Evaluation date" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding EvaluationDate}" HorizontalAlignment="Stretch"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Self-declaration availability" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding SelfDeclarationOptions}" SelectedItem="{Binding SelfDeclarationStatus}" HorizontalAlignment="Stretch"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Button Style="{StaticResource Button.Secondary}" Grid.Column="2"
                                        Content="Upload PDF(s)"
                                        Command="{Binding UploadDocumentsCommand}"
                                        BorderBrush="{DynamicResource Brush.Secondary}"
                                        Cursor="Hand"
                                        VerticalAlignment="Bottom" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Questions -->
                        <Border Grid.Row="2"
                                Margin="0,0,0,12"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                              
                                Padding="8">
                            <ItemsControl ItemsSource="{Binding Questions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0"
                                                BorderThickness="0,0,0,1"
                                                Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding Id}"
                                                        Width="25"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        FontSize="12"/>
                                                <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding QuestionText}"
                                                            FontSize="18" Foreground="{DynamicResource Brush.TextPrimary}"
                                                            FontWeight="SemiBold"
                                                            TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Category}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Grid.Row="1"
                                                          ItemsSource="{Binding OptionLabels}"
                                                          SelectedIndex="{Binding SelectedScore, Converter={StaticResource ScoreToIndexConverter}}"
                                                          FontSize="15"
                                                        Padding="4"
                                                        Margin="8,10,0,8"
                                                          Background="White"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                      />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Documents -->
                        <Border Grid.Row="3"
                                Margin="0,0,0,12"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="White"
                                Padding="12"
                                MinHeight="112"
                                MaxHeight="180">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                        Text="Uploaded documents"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Documents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Border}"
                                                        Background="{DynamicResource Brush.Canvas}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Margin="0,0,0,6"
                                                        Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="{DynamicResource Brush.ClassC}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource Button.Compact}" Grid.Column="1"
                                                                Content="Remove"
                                                                Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Score & Classification -->
                        <Border Grid.Row="4"
                                Margin="0,0,0,12"
                                Background="#F0F7FF"
                                
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Score"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding TotalScore}"
                                            FontSize="32"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.Secondary}"/>
                                    <TextBlock Text="/ 24"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="Classification"
                                            FontSize="12"
                                            Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <Border Background="{Binding Classification, Converter={StaticResource ScoreToClassColorConverter}}"
                                           
                                            Padding="12,4"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Classification, FallbackValue='-'}"
                                                FontSize="28"
                                                FontWeight="SemiBold"
                                                Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding ClassificationAction}"
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Save Evaluation"
                                    Command="{Binding SaveEvaluationCommand}"
                                    Margin="0,0,12,0"
                                    Cursor="Hand">
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
