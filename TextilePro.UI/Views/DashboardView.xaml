<UserControl x:Class="TextilePro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="#F5F5F5">

    <!-- <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources> -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="📊 Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1a1a1a" VerticalAlignment="Center"/>
                <TextBlock Text="(Overview of CCMS data)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <Button Content="🔄 Refresh" Command="{Binding RefreshDashboardCommand}" 
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0"
                        Padding="12,6" FontSize="12" Cursor="Hand" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Stats Cards -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- First Row: Counts -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏭 Suppliers" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding TotalSuppliers}" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0,8,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🧪 Chemicals" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding TotalChemicals}" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="8,0,8,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⭐ Evaluations" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding TotalEvaluations}" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Margin="8,0,0,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 Inventory Records" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding TotalInventoryRecords}" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Second Row: Volume Stats -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" Background="#E8F5E9" CornerRadius="8" Padding="16" BorderBrush="#A5D6A7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Total Volume" FontSize="12" Foreground="#2E7D32"/>
                            <TextBlock Text="{Binding TotalVolume}" FontSize="20" FontWeight="Bold" Foreground="#1a1a1a"/>
                            <TextBlock Text="kg/L" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0,8,0" Background="#E3F2FD" CornerRadius="8" Padding="16" BorderBrush="#90CAF9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Class A Volume" FontSize="12" Foreground="#1565C0"/>
                            <TextBlock Text="{Binding ClassAVolume}" FontSize="20" FontWeight="Bold" Foreground="#1a1a1a"/>
                            <TextBlock Text="kg/L" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="8,0,8,0" Background="#FFF3E0" CornerRadius="8" Padding="16" BorderBrush="#FFCC80" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Virgin Volume" FontSize="12" Foreground="#E65100"/>
                            <TextBlock Text="{Binding VirginVolume}" FontSize="20" FontWeight="Bold" Foreground="#1a1a1a"/>
                            <TextBlock Text="kg/L" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Margin="8,0,0,0" Background="#F3E5F5" CornerRadius="8" Padding="16" BorderBrush="#CE93D8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Non-Virgin Volume" FontSize="12" Foreground="#6A1B9A"/>
                            <TextBlock Text="{Binding NonVirginVolume}" FontSize="20" FontWeight="Bold" Foreground="#1a1a1a"/>
                            <TextBlock Text="kg/L" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Third Row: Chart and Recent Activities -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart -->
                    <Border Grid.Column="0" Margin="0,0,12,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" Height="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📈 Monthly Volume Trend" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding MonthlyVolumeSeries}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                LegendPosition="Top"
                                                Margin="5"/>
                        </Grid>
                    </Border>

                    <!-- Recent Activities -->
                    <Border Grid.Column="1" Margin="12,0,0,0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" Height="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🔄 Recent Activities" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentActivities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Action}" FontSize="11" Foreground="#333" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd MMM yyyy HH:mm}}" FontSize="9" Foreground="#888"/>
                                                        <TextBlock Text="  •  " FontSize="9" Foreground="#888"/>
                                                        <TextBlock Text="{Binding Username}" FontSize="9" Foreground="#888" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status Message -->
                <Border Grid.Row="3" Background="#F0F7FF" CornerRadius="4" Padding="8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#333"/>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>