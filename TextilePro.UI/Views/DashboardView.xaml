<UserControl x:Class="TextilePro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock TextWrapping="Wrap" Text="Compliance overview" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="Your supplier and chemical compliance snapshot for today." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshDashboardCommand}" Style="{StaticResource Button.Secondary}" ToolTip="Refresh dashboard" AutomationProperties.Name="Refresh dashboard">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/><TextBlock Text="Refresh" Margin="8,0,0,0"/></StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card.Compact}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Total suppliers" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding TotalSuppliers}" Style="{StaticResource Text.Kpi}" Margin="0,4,0,0"/><TextBlock Text="Registered partners" Style="{StaticResource Text.Metadata}"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}"><materialDesign:PackIcon Kind="AccountGroupOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource Card.Compact}" Margin="4,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Assigned chemicals" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding AssignedChemicals}" Style="{StaticResource Text.Kpi}" Margin="0,4,0,0"/><TextBlock Text="Supplier assignments" Style="{StaticResource Text.Metadata}"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}"><materialDesign:PackIcon Kind="FlaskOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource Card.Compact}" Margin="8,0,4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Class A share" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding ClassAShare}" Style="{StaticResource Text.Kpi}" Foreground="{DynamicResource Brush.ClassA}" Margin="0,4,0,0"/><TextBlock Text="Of purchase volume" Style="{StaticResource Text.Metadata}"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#E7F3E8"><materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.ClassA}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
                <Border Grid.Column="3" Style="{StaticResource Card.Compact}" Margin="12,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pending evaluations" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding PendingEvaluations}" Style="{StaticResource Text.Kpi}" Foreground="{DynamicResource Brush.ClassB}" Margin="0,4,0,0"/><TextBlock Text="Require attention" Style="{StaticResource Text.Metadata}"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#FFF0E8"><materialDesign:PackIcon Kind="ClipboardAlertOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.ClassB}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            </Grid>

            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card.Standard}" Margin="0,0,8,0" Height="340"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Monthly purchase volume by supplier class" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="Purchase volume (kg/L) across the latest six months" Style="{StaticResource Text.Metadata}" Margin="0,3,0,12"/></StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlyVolumeSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Top" Margin="0,4,0,0"/>
                </Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource Card.Standard}" Margin="8,0,0,0" Height="340"><StackPanel>
                    <TextBlock Text="Volume snapshot" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="Current inventory mix" Style="{StaticResource Text.Metadata}" Margin="0,3,0,18"/>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total volume" Style="{StaticResource Text.Label}"/><TextBlock Grid.Column="1" Text="{Binding TotalVolume, StringFormat={}{0:N0} kg/L}" FontWeight="SemiBold"/></Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Class A volume" Style="{StaticResource Text.Label}"/><TextBlock Grid.Column="1" Text="{Binding ClassAVolume, StringFormat={}{0:N0} kg/L}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ClassA}"/></Grid>
                    <Separator Background="{DynamicResource Brush.Border}" Margin="0,2,0,16"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Virgin" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding VirginShare}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding VirginVolume, StringFormat={}{0:N1} kg/L}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Non-virgin" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding NonVirginShare}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding NonVirginVolume, StringFormat={}{0:N1} kg/L}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    <Border Background="{DynamicResource Brush.FabricWarm}" CornerRadius="6" Padding="12" Margin="0,22,0,0"><TextBlock Text="Responsible chemistry supports safer, more traceable textiles." Foreground="{DynamicResource Brush.Primary}" FontSize="11" TextWrapping="Wrap"/></Border>
                </StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource Card.Standard}" Margin="0,0,0,12"><StackPanel>
                <TextBlock Text="Quick actions" Style="{StaticResource Text.SectionTitle}"/>
                <TextBlock Text="Start the most common compliance workflows." Style="{StaticResource Text.Metadata}" Margin="0,3,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource Button.Secondary}" Click="RegisterSupplier_Click" Margin="0,0,8,0" Padding="16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="24" Height="24" Foreground="{DynamicResource Brush.Secondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="Register supplier" FontWeight="SemiBold"/><TextBlock Text="Create a new supplier record" Style="{StaticResource Text.Metadata}" Margin="0,3,0,0"/></StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Click="EvaluateSupplier_Click" Margin="4,0" Padding="16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="24" Height="24" Foreground="{DynamicResource Brush.Secondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="Evaluate supplier" FontWeight="SemiBold"/><TextBlock Text="Complete compliance scoring" Style="{StaticResource Text.Metadata}" Margin="0,3,0,0"/></StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Click="ImportInventory_Click" Margin="8,0,0,0" Padding="16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FileUploadOutline" Width="24" Height="24" Foreground="{DynamicResource Brush.Secondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="Import inventory" FontWeight="SemiBold"/><TextBlock Text="Upload a validated Excel template" Style="{StaticResource Text.Metadata}" Margin="0,3,0,0"/></StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel></Border>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Metadata}" HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
