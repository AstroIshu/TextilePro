<Window x:Class="TextilePro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TextilePro.UI.Views"
        Title="Winsome Textile - CCMS"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1a3a5c"
                Padding="16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="🏭 Winsome Textile"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="CCMS"
                           FontSize="18"
                           Foreground="#64B5F6"
                           Margin="10,0,0,0"/>
                <TextBlock Text="👤 Profile"
                           FontSize="12"
                           Foreground="White"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    Margin="16"
                    Background="White"
                    BorderThickness="0">

            <TabItem Header="📊 Dashboard"
                     x:Name="DashboardTab">
                <views:DashboardView/>
            </TabItem>

            <TabItem Header="🏭 Suppliers"
                     x:Name="SupplierTab">
                <views:SupplierView/>
            </TabItem>

            <TabItem Header="🧪 Chemicals"
                     x:Name="ChemicalTab"
                     IsSelected="True">
                <views:ChemicalView/>
            </TabItem>

            <TabItem Header="⭐ Evaluations"
                     x:Name="EvaluationTab">
                <views:EvaluationView/>
            </TabItem>

            <TabItem Header="🏷️ Classification"
                     x:Name="ClassificationTab">
                <views:ClassificationView/>
            </TabItem>

            <TabItem Header="📦 Inventory"
                     x:Name="InventoryTab">
                <views:InventoryView/>
            </TabItem>

            <TabItem Header="📈 Analysis"
                     x:Name="AnalysisTab">
                <views:AnalysisView/>
            </TabItem>

            <TabItem Header="🎯 Target 2030"
                     x:Name="TargetTab">
                <views:TargetView/>
            </TabItem>

            <TabItem Header="📋 Audit"
                     x:Name="AuditTab"
                     Visibility="Collapsed">
                <views:AuditView/>
            </TabItem>

            <TabItem Header="📄 Reports"
                     x:Name="ReportsTab">
                <views:ReportView/>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#E0E0E0"
                Padding="8">
            <TextBlock Text="© Winsome Textile Industries Ltd. | All rights reserved."
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Foreground="#666666"/>
        </Border>
    </Grid>
</Window>