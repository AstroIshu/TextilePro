<Window x:Class="TextilePro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TextilePro.UI.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="TextilePro — Chemical Compliance" Height="900" Width="1440" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Canvas}">
    <Window.Resources>
        <Style x:Key="SidebarTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,2"/><Setter Property="Padding" Value="14,0"/><Setter Property="MinHeight" Value="46"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <StackPanel>
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,8,0,4" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyTextToVisibilityConverter}}"/>
                    <Border x:Name="NavItem" Height="46" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="11,0"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource Brush.Secondary}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource Brush.ThreadBeige}"/><Setter Property="Foreground" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <TabControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarTab}" SelectedIndex="0">
        <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></TabControl.ItemsPanel>
        <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="126"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,17,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource Brush.Primary}"><Grid>
                        <Rectangle Width="21" Height="6" RadiusX="2" RadiusY="2" Fill="White" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="21" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.ThreadBeige}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform></Rectangle>
                    </Grid></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TextilePro" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}"/><TextBlock Text="Chemical Compliance" Style="{StaticResource Text.Metadata}"/></StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="16,0" Padding="0,12">
                    <StackPanel>
                        <Button Style="{StaticResource Button.Primary}" Content="Save all" Click="SaveAll_Click" Margin="0,0,0,8" ToolTip="Save pending changes"/>
                        <Button Style="{StaticResource Button.Secondary}" Content="Exit application" Click="ExitApplication_Click"/>
                    </StackPanel>
                </Border>
            </Grid></Border>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" Padding="12"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
        </Grid></ControlTemplate></TabControl.Template>
        <TabItem x:Name="DashboardTab" Tag="OVERVIEW"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20"/><TextBlock Text="Dashboard" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:DashboardView/></TabItem>
        <TabItem x:Name="SupplierTab" Tag="SUPPLIER &amp; CHEMICAL DATA"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroupOutline" Width="20" Height="20"/><TextBlock Text="Suppliers" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:SupplierView/></TabItem>
        <TabItem x:Name="ChemicalTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FlaskOutline" Width="20" Height="20"/><TextBlock Text="Commodity chemicals" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:ChemicalView/></TabItem>
        <TabItem x:Name="EvaluationTab" Tag="COMPLIANCE"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="20" Height="20"/><TextBlock Text="Supplier evaluation" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:EvaluationView/></TabItem>
        <TabItem x:Name="ClassificationTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewGridOutline" Width="20" Height="20"/><TextBlock Text="Classification matrix" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:ClassificationView/></TabItem>
        <TabItem x:Name="InventoryTab" Tag="INVENTORY &amp; ANALYTICS"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20"/><TextBlock Text="CC inventory" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:InventoryView/></TabItem>
        <TabItem x:Name="AnalysisTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"/><TextBlock Text="Purchase analysis" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:AnalysisView/></TabItem>
        <TabItem x:Name="TargetTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Target" Width="20" Height="20"/><TextBlock Text="Target analysis" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:TargetView/></TabItem>
        <TabItem x:Name="ReportsTab" Tag="REPORTING"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileChartOutline" Width="20" Height="20"/><TextBlock Text="Reports" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:ReportView/></TabItem>
        <TabItem x:Name="AuditTab" Tag="ADMINISTRATION" Visibility="Collapsed"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="History" Width="20" Height="20"/><TextBlock Text="Audit trail" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><views:AuditView/></TabItem>
    </TabControl>
</Window>
