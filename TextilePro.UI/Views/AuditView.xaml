<UserControl x:Class="TextilePro.UI.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource Brush.Canvas}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <WrapPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">

            <TextBlock TextWrapping="Wrap" Text="Audit Log"
                       Style="{StaticResource Text.PageTitle}"
                       VerticalAlignment="Center"/>

            <TextBlock Text="(Activity tracking  Admin only)"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </WrapPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0"
                    CornerRadius="8"
                    Background="White"
                    Padding="16"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="User" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Usernames}" SelectedItem="{Binding SelectedUsername}" MinWidth="140"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Role" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" MinWidth="120"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="From date" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding FromDate}" SelectedDateFormat="Short" MinWidth="165"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="To date" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding ToDate}" SelectedDateFormat="Short" MinWidth="165"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Search activity" Style="{StaticResource Text.Label}" Margin="0,0,0,5"/><Grid><TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,8,8" AutomationProperties.Name="Search audit activity"/><materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"/></Grid></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="Apply filters" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Reset" Command="{Binding ResetFiltersCommand}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="3" Style="{StaticResource Button.Secondary}" Content="Export CSV" Command="{Binding ExportLogsCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Log DataGrid -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="White"
                    Padding="16"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <TextBlock Text="Log Entries"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>

                        <TextBlock Text="{Binding Logs.Count}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Secondary}"
                                   Margin="8,0,0,0"/>

                        <TextBlock Text="records"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Logs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42"
                              FontSize="12"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding Action}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Table"
                                                Binding="{Binding TableAffected}"
                                                Width="120"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
