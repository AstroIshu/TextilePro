<UserControl x:Class="TextilePro.UI.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TextilePro.UI.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">

            <TextBlock Text="Audit Log"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1a1a1a"
                       VerticalAlignment="Center"/>

            <TextBlock Text="(Activity tracking  Admin only)"
                       FontSize="12"
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0"
                    CornerRadius="8"
                    Background="White"
                    Padding="16"
                    Margin="0,0,0,12"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- First filter row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="User:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Usernames}"
                                  SelectedItem="{Binding SelectedUsername}"
                                  Margin="0,0,16,0"
                                  Padding="4"
                                  FontSize="12"
                                  Height="30"/>

                        <TextBlock Grid.Column="2"
                                   Text="From:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker Grid.Column="3"
                                    SelectedDate="{Binding FromDate}"
                                    Margin="0,0,16,0"
                                    Height="30"
                                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="To:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker Grid.Column="5"
                                    SelectedDate="{Binding ToDate}"
                                    Margin="0,0,16,0"
                                    Height="30"
                                    VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal">

                            <Button Content="Apply"
                                    Command="{Binding ApplyFiltersCommand}"
                                    Background="#0078D4"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="12,4"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,8,0"/>

                            <Button Content="Reset"
                                    Command="{Binding ResetFiltersCommand}"
                                    Background="#E0E0E0"
                                    Foreground="#333"
                                    BorderThickness="0"
                                    Padding="12,4"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search / Export row -->
                    <Grid Grid.Row="1"
                          Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Height="30"
                                 Margin="0,0,8,0"/>

                        <Button Grid.Column="1"
                                Content="Export CSV"
                                Command="{Binding ExportLogsCommand}"
                                Background="#E0E0E0"
                                Foreground="#333"
                                BorderThickness="0"
                                Padding="12,4"
                                FontSize="12"
                                Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Log DataGrid -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="White"
                    Padding="16"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <TextBlock Text="Log Entries"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#333"/>

                        <TextBlock Text="{Binding Logs.Count}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#0078D4"
                                   Margin="8,0,0,0"/>

                        <TextBlock Text="records"
                                   FontSize="12"
                                   Foreground="#888"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Logs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              FontSize="12"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding Action}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Table"
                                                Binding="{Binding TableAffected}"
                                                Width="120"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>